# Stage 6A LLM Provider & Orchestrator Configuration
# Copy this template to .env to configure local runtime settings.
# DO NOT commit real API keys or secrets to version control.

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENABLE_WARMUP=true
LOG_LEVEL=INFO

# Provider selection: OPENAI, GEMINI, or MOCK
LLM_PROVIDER=MOCK

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Operational Parameters
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=2
OFFLINE_MODE=true

# Prompt Version
PROMPT_VERSION=v1

